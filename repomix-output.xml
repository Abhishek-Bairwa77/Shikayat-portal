import { useState } from 'react';
import { useAuth } from '../../context/AuthContext';
import { Icons } from '../../Icons'; 
import './SlidingAuth.css';
import logo from '../../assets/logo.png'
const SlidingAuth = () => {
  const [isLogin, setIsLogin] = useState(true);
  const [loading, setLoading] = useState(false);
  const [formError, setFormError] = useState('');
  const [formSuccess, setFormSuccess] = useState('');
  const { login, register } = useAuth();

  const [loginData, setLoginData] = useState({
    identifier: '',
    password: ''
  });

  const [registerData, setRegisterData] = useState({
    rollNumber: '',
    username: '',
    email: '',
    mobile: '',
    password: '',
    confirmPassword: '',
    actionPin: '',
    department: 'CSE'
  });

  const handleLoginChange = (e) => {
    setLoginData({ ...loginData, [e.target.name]: e.target.value });
    setFormError('');
  };

  const handleRegisterChange = (e) => {
    setRegisterData({ ...registerData, [e.target.name]: e.target.value });
    setFormError('');
  };

  const handleLoginSubmit = async (e) => {
    e.preventDefault();
    setFormError('');
    setFormSuccess('');

    if (!loginData.identifier.trim() || !loginData.password.trim()) {
      setFormError('Please enter both identifier and password');
      return;
    }

    setLoading(true);
    const result = await login(loginData.identifier.trim(), loginData.password);
    setLoading(false);

    if (!result.success) {
      setFormError(result.error);
    }
  };

  const handleRegisterSubmit = async (e) => {
    e.preventDefault();
    setFormError('');
    setFormSuccess('');

    const { rollNumber, username, email, password, confirmPassword, actionPin } = registerData;

    if (!rollNumber.trim() || !username.trim() || !email.trim() || !password || !actionPin) {
      setFormError('All required fields must be filled');
      return;
    }

    if (password.length < 6) {
      setFormError('Password must be at least 6 characters');
      return;
    }

    if (password !== confirmPassword) {
      setFormError('Passwords do not match');
      return;
    }

    if (!/^\d{4}$/.test(actionPin)) {
      setFormError('Action PIN must be exactly 4 digits');
      return;
    }

    setLoading(true);
    const result = await register({
      rollNumber: rollNumber.trim(),
      username: username.trim(),
      email: email.trim(),
      mobile: registerData.mobile.trim(),
      password,
      actionPin,
      department: registerData.department
    });
    setLoading(false);

    if (result.success) {
      setFormSuccess('Registration successful! Logging you in...');
    } else {
      setFormError(result.error);
    }
  };

  return (
    <div className="auth-container">
      <div className={`auth-wrapper ${isLogin ? 'login-mode' : 'register-mode'}`}>
        
        <div className="branding-panel">
          <div className="branding-content">
            <div className="brand-logo">
              <img 
                src={logo} 
                alt="SHIKAYAT Logo" 
                className="custom-logo-img" 
              />
              <h1 className="logo-text">SHIKAYAT</h1>
            </div>
            <p className="brand-tagline">Student Grievance Redressal Portal</p>
            
            <div className="brand-features">
              <div className="feature-item">
                <Icons.Lock size={20} />
                <span>Anonymous & Secure</span>
              </div>
              <div className="feature-item">
                <Icons.Vote size={20} />
                <span>Democratic Upvoting</span>
              </div>
              <div className="feature-item">
                <Icons.Chart size={20} />
                <span>Transparent Tracking</span>
              </div>
            </div>
            
            <p className="brand-footer">Your voice matters. Report safely.</p>
          </div>
          
          <div className="branding-decoration">
            <div className="deco-circle deco-1"></div>
            <div className="deco-circle deco-2"></div>
            <div className="deco-circle deco-3"></div>
          </div>
        </div>

        <button
          className="toggle-btn"
          onClick={() => {
            setIsLogin(!isLogin);
            setFormError('');
            setFormSuccess('');
          }}
          aria-label="Toggle auth mode"
        >
          <span className={`arrow ${isLogin ? '' : 'rotate'}`}>&gt;</span>
        </button>

        <div className="form-panel">
          
          <div className={`form-content login-content ${isLogin ? 'active' : ''}`}>
            <div className="form-header">
              <h2>Welcome Back</h2>
              <p>Sign in to access your grievance portal</p>
            </div>

            <form onSubmit={handleLoginSubmit} className="auth-form">
              <div className="input-group">
                <label htmlFor="identifier">Roll Number / Email / Username</label>
                <input
                  type="text"
                  id="identifier"
                  name="identifier"
                  value={loginData.identifier}
                  onChange={handleLoginChange}
                  placeholder="Enter your Roll Number or Email"
                  autoComplete="username"
                />
              </div>

