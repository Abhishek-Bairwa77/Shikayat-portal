<file path="client/src/components/Admin/AdminPanel.css">
.admin-container {
  display: flex;
  min-height: 100vh;
  background: var(--gray-100);
}

/* Sidebar */
.admin-sidebar {
  width: 16vw;
  min-width: 220px;
  background: var(--navy-dark);
  color: var(--white);
  display: flex;
  flex-direction: column;
  padding: 3vh 1vw;
  position: sticky;
  top: 0;
  height: 100vh;
}

.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 0.6vw;
  margin-bottom: 4vh;
  padding: 0 0.8vw;
}

.sidebar-logo span { font-size: 1.6vw; }
.sidebar-logo h1 {
  font-size: 1.2vw;
  font-weight: 800;
  letter-spacing: 0.1vw;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 0.6vh;
  flex: 1;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 0.8vw;
  padding: 1.2vh 1vw;
  background: transparent;
  color: rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-md);
  font-size: 0.85vw;
  font-weight: 500;
  text-align: left;
  transition: all 0.2s;
  position: relative;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--white);
}

.nav-item.active {
  background: rgba(59, 130, 246, 0.2);
  color: var(--white);
  border-left: 3px solid var(--accent-blue);
}

.badge-count {
  margin-left: auto;
  background: var(--accent-red);
  color: var(--white);
  font-size: 0.65vw;
  font-weight: 700;
  padding: 0.2vh 0.5vw;
  border-radius: 999px;
  min-width: 1.4vw;
  text-align: center;
}

.sidebar-footer {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 2vh;
}

.logout-btn {
  color: rgba(255, 100, 100, 0.85);
}

.logout-btn:hover {
  background: rgba(220, 38, 38, 0.15);
  color: #ff8a8a;
}

/* Content */
.admin-content {
  flex: 1;
  padding: 3vh 2vw;
  overflow-y: auto;
  max-height: 100vh;
}

.admin-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2vw;
  margin-bottom: 3vh;
  flex-wrap: wrap;
}

.admin-header h2 {
  font-size: 1.6vw;
  font-weight: 700;
  color: var(--navy-dark);
  margin-bottom: 0.4vh;
}

.admin-header p {
  font-size: 0.85vw;
  color: var(--gray-500);
}

.back-btn {
  padding: 1vh 1.3vw;
  background: var(--white);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-md);
  font-size: 0.85vw;
  font-weight: 600;
  color: var(--gray-700);
  transition: all 0.2s;
}

.back-btn:hover {
  background: var(--gray-50);
  border-color: var(--gray-300);
}

/* Stats */
.admin-stats {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1vw;
  margin-bottom: 3vh;
}

.stat-box {
  background: var(--white);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-md);
  padding: 2vh 1vw;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4vh;
  transition: all 0.25s;
}

.stat-box:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.stat-box .stat-value {
  font-size: 1.8vw;
  font-weight: 800;
  color: var(--navy-dark);
}

.stat-box .stat-name {
  font-size: 0.75vw;
  color: var(--gray-500);
  text-transform: uppercase;
  letter-spacing: 0.05vw;
  font-weight: 600;
}

.stat-conf .stat-value { color: var(--accent-purple); }
.stat-escalated .stat-value { color: var(--accent-red); }
.stat-resolved .stat-value { color: var(--accent-green); }
.stat-pending .stat-value { color: var(--accent-orange); }

/* Body */
.admin-body {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 1.5vw;
  align-items: start;
}

/* List panel */
.grievance-list-panel {
  background: var(--white);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  padding: 1vw;
  max-height: 70vh;
  overflow-y: auto;
}

.grievance-list {
  display: flex;
  flex-direction: column;
  gap: 0.8vh;
}

.grievance-list-item {
  padding: 1.2vh 1vw;
  border-radius: var(--radius-md);
  border: 1px solid var(--gray-100);
  cursor: pointer;
  transition: all 0.2s;
}

.grievance-list-item:hover {
  background: var(--gray-50);
  border-color: var(--gray-200);
}

.grievance-list-item.selected {
  background: rgba(59, 130, 246, 0.08);
  border-color: var(--accent-blue);
}

.item-header {
  display: flex;
  align-items: center;
  gap: 0.5vw;
  margin-bottom: 0.6vh;
}

.item-status {
  font-size: 0.65vw;
  font-weight: 700;
  padding: 0.2vh 0.6vw;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.03vw;
}

.item-status.status-submitted { background: rgba(107, 114, 128, 0.12); color: var(--gray-600); }
.item-status.status-in-review { background: rgba(249, 115, 22, 0.12); color: var(--accent-orange); }
.item-status.status-in-progress { background: rgba(59, 130, 246, 0.12); color: var(--accent-blue); }
.item-status.status-resolved { background: rgba(34, 197, 94, 0.12); color: var(--accent-green); }

.item-priority, .item-conf {
  font-size: 0.9vw;
}

.item-title {
  font-size: 0.9vw;
  font-weight: 600;
  color: var(--gray-800);
  margin-bottom: 0.4vh;
  line-height: 1.3;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 0.4vw;
  font-size: 0.7vw;
  color: var(--gray-500);
  flex-wrap: wrap;
}

.admin-loading, .admin-empty {
  padding: 4vh 2vw;
  text-align: center;
  color: var(--gray-500);
  font-size: 0.9vw;
}

/* Detail panel */
.grievance-detail-panel {
  background: var(--white);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  padding: 2vh 1.5vw;
  min-height: 70vh;
  max-height: 75vh;
  overflow-y: auto;
}

.detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1vh;
  height: 60vh;
  color: var(--gray-400);
}

.detail-empty span { font-size: 3vw; }
.detail-empty p { font-size: 0.9vw; }

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 2vh;
}

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1vw;
  flex-wrap: wrap;
  padding-bottom: 1.5vh;
  border-bottom: 1px solid var(--gray-200);
}

.detail-header h3 {
  font-size: 1.15vw;
  font-weight: 700;
  color: var(--navy-dark);
  flex: 1;
  line-height: 1.4;
}

.conf-badge {
  font-size: 0.7vw;
  background: rgba(124, 58, 237, 0.1);
  color: var(--accent-purple);
  padding: 0.4vh 0.8vw;
  border-radius: 999px;
  font-weight: 700;
  white-space: nowrap;
}

.detail-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1vh 1.5vw;
  font-size: 0.8vw;
  color: var(--gray-600);
}

.detail-meta-grid strong { color: var(--gray-800); }

.detail-description strong,
.detail-attachments strong,
.status-history strong {
  display: block;
  font-size: 0.85vw;
  color: var(--gray-800);
  margin-bottom: 0.8vh;
}

.detail-description p {
  font-size: 0.82vw;
  color: var(--gray-600);
  line-height: 1.7;
  background: var(--gray-50);
  padding: 1.2vh 1vw;
  border-radius: var(--radius-sm);
  white-space: pre-wrap;
}

.attachment-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6vw;
}

.attachment-link {
  padding: 0.6vh 1vw;
  background: rgba(59, 130, 246, 0.08);
  color: var(--accent-blue);
  border-radius: var(--radius-sm);
  font-size: 0.75vw;
  font-weight: 600;
  transition: all 0.2s;
}

.attachment-link:hover {
  background: rgba(59, 130, 246, 0.15);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 1vh;
}

.history-item {
  display: flex;
  gap: 0.8vw;
  padding-left: 0.3vw;
}

.history-dot {
  width: 10px;
  height: 10px;
  min-width: 10px;
  border-radius: 50%;
  margin-top: 0.4vh;
}

.history-dot.status-submitted { background: var(--gray-500); }
.history-dot.status-in-review { background: var(--accent-orange); }
.history-dot.status-in-progress { background: var(--accent-blue); }
.history-dot.status-resolved { background: var(--accent-green); }

.history-status {
  font-size: 0.8vw;
  font-weight: 700;
  color: var(--gray-800);
  text-transform: capitalize;
  margin-right: 0.8vw;
}

.history-date {
  font-size: 0.72vw;
  color: var(--gray-400);
}

.history-remarks {
  font-size: 0.75vw;
  color: var(--gray-600);
  margin-top: 0.3vh;
  line-height: 1.5;
}

.update-form {
  background: var(--gray-50);
  border-radius: var(--radius-md);
  padding: 1.5vh 1.2vw;
  display: flex;
  flex-direction: column;
  gap: 1.2vh;
  margin-top: 1vh;
}

.update-form h4 {
  font-size: 0.95vw;
  font-weight: 700;
  color: var(--navy-dark);
}

.update-field {
  display: flex;
  flex-direction: column;
  gap: 0.5vh;
}

.update-field label {
  font-size: 0.78vw;
  font-weight: 600;
  color: var(--gray-700);
}

.update-field select,
.update-field textarea {
  padding: 1vh 0.8vw;
  border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: 0.82vw;
  background: var(--white);
  color: var(--gray-800);
  font-family: inherit;
  resize: vertical;
  transition: all 0.2s;
}

.update-field select:focus,
.update-field textarea:focus {
  border-color: var(--accent-blue);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.update-btn {
  padding: 1.2vh;
  background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy-light) 100%);
  color: var(--white);
  border-radius: var(--radius-md);
  font-size: 0.85vw;
  font-weight: 600;
  transition: all 0.2s;
}

.update-btn:hover:not(:disabled) {
  background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-cyan) 100%);
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(59, 130, 246, 0.3);
}

.update-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Toast (reuse) */
.toast {
  position: fixed;
  bottom: 3vh;
  right: 2vw;
  padding: 1.5vh 1.5vw;
  border-radius: var(--radius-md);
  font-size: 0.9vw;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.8vw;
  box-shadow: var(--shadow-xl);
  z-index: 2000;
  animation: slideUp 0.3s ease;
  max-width: 30vw;
}

.toast span { font-size: 1.1vw; font-weight: 700; }
.toast-success { background: var(--white); color: var(--accent-green); border-left: 4px solid var(--accent-green); }
.toast-error { background: var(--white); color: var(--accent-red); border-left: 4px solid var(--accent-red); }

@media (max-width: 1024px) {
  .admin-sidebar { width: 20vw; }
  .sidebar-logo h1 { font-size: 1.5vw; }
  .nav-item { font-size: 1vw; }
  .badge-count { font-size: 0.8vw; }
  .admin-header h2 { font-size: 2vw; }
  .admin-header p { font-size: 1.05vw; }
  .back-btn { font-size: 1vw; }
  .stat-box .stat-value { font-size: 2.2vw; }
  .stat-box .stat-name { font-size: 0.9vw; }
  .admin-body { grid-template-columns: 1fr 1.4fr; }
  .item-title { font-size: 1.1vw; }
  .item-meta { font-size: 0.9vw; }
  .detail-header h3 { font-size: 1.4vw; }
  .detail-meta-grid { font-size: 1vw; }
  .detail-description p { font-size: 1vw; }
  .history-status { font-size: 1vw; }
  .history-date { font-size: 0.9vw; }
  .history-remarks { font-size: 0.9vw; }
  .update-form h4 { font-size: 1.2vw; }
  .update-field label { font-size: 1vw; }
  .update-field select, .update-field textarea { font-size: 1vw; }
  .update-btn { font-size: 1.05vw; }
  .item-status { font-size: 0.8vw; }
}

@media (max-width: 768px) {
  .admin-container { flex-direction: column; }
  .admin-sidebar {
    width: 100vw;
    height: auto;
    position: relative;
    flex-direction: row;
    align-items: center;
    padding: 1.5vh 3vw;
    gap: 3vw;
  }
  .sidebar-logo { margin-bottom: 0; }
  .sidebar-logo h1 { font-size: 4vw; }
  .sidebar-logo span { font-size: 5vw; }
  .sidebar-nav { flex-direction: row; flex: 1; gap: 2vw; }
  .nav-item { font-size: 3vw; padding: 1vh 2vw; border-radius: var(--radius-sm); }
  .badge-count { font-size: 2.4vw; min-width: unset; padding: 0.2vh 1.5vw; }
  .sidebar-footer { border: none; padding: 0; }
