/* =========================================
   DASHBOARD DARK THEME
   ========================================= */
.dashboard-dark-container {
  display: flex;
  min-height: 100vh;
  width: 100vw;
  background-color: #0b1120;
  color: #f8fafc;
  overflow: hidden;
}

.dashboard-main-content {
  flex: 1;
  padding: 40px;
  overflow-y: auto;
  height: 100vh;
}

/* Header */
.dash-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40px;
}

.dash-welcome {
  font-size: 28px;
  font-weight: 700;
  color: #f8fafc;
  margin: 0 0 8px 0;
}

.dash-subtext {
  color: #94a3b8;
  font-size: 15px;
  margin: 0;
}

.dash-new-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #06b6d4;
  color: #ffffff;
  border: none;
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.dash-new-btn:hover {
  background: #0891b2;
  transform: translateY(-2px);
}

/* Stats Grid */
.dash-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 40px;
}

.dash-stat-card {
  background: #131c2f;
  border: 1px solid #1e293b;
  border-radius: 16px;
  padding: 24px;
  display: flex;
  align-items: center;
  gap: 20px;
  transition: transform 0.2s;
}

.dash-stat-card:hover {
  transform: translateY(-3px);
  border-color: #334155;
}

.dash-stat-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dash-stat-icon.blue { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
.dash-stat-icon.green { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
.dash-stat-icon.orange { background: rgba(249, 115, 22, 0.15); color: #f97316; }
.dash-stat-icon.red { background: rgba(220, 38, 38, 0.15); color: #dc2626; }

.dash-stat-info {
  display: flex;
  flex-direction: column;
}

.dash-stat-value {
  font-size: 24px;
  font-weight: 800;
  color: #f8fafc;
}

.dash-stat-label {
  font-size: 13px;
  color: #94a3b8;
  font-weight: 500;
}

/* Filters */
.dash-filters {
  display: flex;
  gap: 20px;
  margin-bottom: 30px;
  background: #131c2f;
  padding: 16px 24px;
  border-radius: 12px;
  border: 1px solid #1e293b;
}

.dash-filter-group {
  display: flex;
  align-items: center;
  gap: 12px;
}

.dash-filter-group span {
  color: #94a3b8;
  font-size: 14px;
  font-weight: 600;
}

.dash-filter-group select {
  background: #0f172a;
  color: #f8fafc;
  border: 1px solid #1e293b;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 14px;
  outline: none;
  cursor: pointer;
}

.dash-filter-group select:focus {
  border-color: #06b6d4;
}

/* =========================================
   OVERRIDE PROBLEM CARDS FOR DARK THEME
   (Kyunki ProblemFeed abhi light theme me hai)
   ========================================= */
.dash-feed-wrapper .problem-feed {
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
}

.dash-feed-wrapper .problem-card {
  background: #131c2f;
  border: 1px solid #1e293b;
  color: #f8fafc;
}

.dash-feed-wrapper .problem-card:hover {
  border-color: #334155;
  box-shadow: 0 8px 30px rgba(0,0,0,0.4);
}

.dash-feed-wrapper .card-title {
  color: #f8fafc;
}

.dash-feed-wrapper .card-description {
  color: #cbd5e1;
}

.dash-feed-wrapper .card-footer {
  border-top-color: #1e293b;
}

.dash-feed-wrapper .vote-btn {
  background: #1e293b;
  border-color: #334155;
  color: #cbd5e1;
}

.dash-feed-wrapper .vote-btn:hover:not(.voted) {
  background: #06b6d4;
  border-color: #06b6d4;
  color: white;
}

.dash-feed-wrapper .count-number {
  color: #f8fafc;
}

/* Mobile Responsive */
@media (max-width: 1024px) {
  .dash-stats-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .dashboard-main-content { padding: 20px; }
  .dash-header { flex-direction: column; gap: 20px; align-items: flex-start; }
  .dash-stats-grid { grid-template-columns: 1fr; }
  .dash-filters { flex-direction: column; }
}
</file>

