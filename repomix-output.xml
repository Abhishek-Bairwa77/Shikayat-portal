  border-radius: 50%;
  cursor: pointer;
  overflow: hidden;
  border: 3px solid var(--white);
  box-shadow: var(--shadow-md);
}

.avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-initial {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--navy-dark) 0%, var(--accent-blue) 100%);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3vw;
  font-weight: 700;
}

.avatar-overlay {
  position: absolute;
  inset: 0;
  background: rgba(15, 30, 54, 0.7);
  color: var(--white);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s;
}

.avatar-overlay span { font-size: 1.5vw; }
.avatar-overlay p { font-size: 0.7vw; margin-top: 0.3vh; }

.avatar-preview-container:hover .avatar-overlay {
  opacity: 1;
}

.avatar-info h4 {
  font-size: 1.4vw;
  font-weight: 700;
  color: var(--navy-dark);
}

.avatar-info p {
  font-size: 0.85vw;
  color: var(--gray-600);
  margin-top: 0.3vh;
}

.avatar-info small {
  display: block;
  font-size: 0.75vw;
  color: var(--gray-400);
  margin-top: 1vh;
}

.profile-form {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2vh 1.5vw;
}

.profile-form .form-group {
  display: flex;
  flex-direction: column;
  gap: 0.6vh;
}

.profile-form .form-group label {
  font-size: 0.85vw;
  font-weight: 600;
  color: var(--gray-700);
}

.profile-form input,
.profile-form select {
  padding: 1.2vh 1vw;
  border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-md);
  font-size: 0.9vw;
  background: var(--white);
  color: var(--gray-800);
  transition: all 0.2s;
}

.profile-form input:focus,
.profile-form select:focus {
  border-color: var(--accent-blue);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.profile-form .disabled-input {
  background: var(--gray-100);
  color: var(--gray-500);
  cursor: not-allowed;
}

.profile-form small {
  font-size: 0.7vw;
  color: var(--gray-400);
}

.save-btn {
  grid-column: span 2;
  padding: 1.4vh;
  background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy-light) 100%);
  color: var(--white);
  border-radius: var(--radius-md);
  font-size: 0.95vw;
  font-weight: 600;
  transition: all 0.2s;
  margin-top: 1vh;
}

.save-btn:hover:not(:disabled) {
  background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-cyan) 100%);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);
}

.save-btn:disabled { opacity: 0.6; cursor: not-allowed; }

/* =======================================================
   3. SECURITY TAB (Password & PIN cards)
   ======================================================= */
.security-card {
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  padding: 2.5vh 2vw;
  margin-bottom: 3vh;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 1vw;
  margin-bottom: 2vh;
  padding-bottom: 1.5vh;
  border-bottom: 1px solid var(--gray-100);
}

.card-icon {
  font-size: 1.5vw;
  background: var(--gray-100);
  padding: 1vh;
  border-radius: var(--radius-md);
}

.card-title h3 {
  font-size: 1.1vw;
  font-weight: 700;
  color: var(--navy-dark);
}

.card-title p {
  font-size: 0.8vw;
  color: var(--gray-500);
}

.security-form {
  display: flex;
  flex-direction: column;
  gap: 1.5vh;
  max-width: 25vw;
}

.security-form .form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5vh;
}

.security-form label {
  font-size: 0.85vw;
  font-weight: 600;
  color: var(--gray-700);
}

.security-form input {
  padding: 1.2vh 1vw;
  border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-md);
  font-size: 0.9vw;
  transition: all 0.2s;
}

.security-form input:focus {
  border-color: var(--accent-blue);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.update-btn {
  padding: 1.2vh;
  background: var(--navy-dark);
  color: var(--white);
  border-radius: var(--radius-md);
  font-size: 0.9vw;
  font-weight: 600;
  transition: all 0.2s;
  margin-top: 1vh;
}

.update-btn:hover:not(:disabled) {
  background: var(--accent-blue);
}

/* Danger Zone */
.danger-zone {
  margin-top: 4vh;
  padding: 2.5vh 2vw;
  background: rgba(220, 38, 38, 0.04);
  border: 1.5px solid rgba(220, 38, 38, 0.2);
  border-radius: var(--radius-lg);
}

.danger-zone h3 {
  font-size: 1.1vw;
  color: var(--accent-red);
  margin-bottom: 1vh;
}

.danger-zone p {
  font-size: 0.85vw;
  color: var(--gray-600);
  margin-bottom: 2vh;
  max-width: 40vw;
}

.delete-account-btn {
  padding: 1.2vh 1.5vw;
  background: var(--accent-red);
  color: var(--white);
  border-radius: var(--radius-md);
  font-size: 0.9vw;
  font-weight: 600;
  transition: all 0.2s;
}

.delete-account-btn:hover {
  background: #b91c1c;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
}

/* =======================================================
   4. MY GRIEVANCES TAB (Accordion list)
   ======================================================= */
.my-grievances-list {
  display: flex;
  flex-direction: column;
  gap: 1.5vh;
}

.my-grievance-card {
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-md);
  background: var(--white);
  transition: all 0.2s;
  overflow: hidden;
}

.my-grievance-card:hover {
  border-color: var(--gray-300);
  box-shadow: var(--shadow-sm);
}

.my-grievance-card.expanded {
  border-color: var(--accent-blue);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.08);
}

.card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.8vh 1.5vw;
  cursor: pointer;
  gap: 1vw;
}

.card-left h4 {
  font-size: 1vw;
  font-weight: 600;
  color: var(--navy-dark);
  margin-bottom: 0.8vh;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.8vw;
  font-size: 0.75vw;
  color: var(--gray-500);
}

.dept-tag {
  padding: 0.3vh 0.8vw;
  background: var(--gray-100);
  border-radius: 999px;
  font-weight: 600;
  color: var(--gray-600);
}

.conf-tag {
  color: var(--accent-purple);
  background: rgba(124, 58, 237, 0.1);
  padding: 0.3vh 0.8vw;
  border-radius: 999px;
  font-weight: 600;
}

.card-right {
  display: flex;
  align-items: center;
  gap: 1.5vw;
}

.expand-arrow {
  font-size: 1vw;
  color: var(--gray-400);
  transition: transform 0.3s;
}

.expand-arrow.open {
  transform: rotate(180deg);
}

.card-expanded-content {
  padding: 0 1.5vw 2vh 1.5vw;
  border-top: 1px solid var(--gray-100);
  animation: slideDown 0.3s ease;
}

.expanded-desc,
.expanded-remarks,
.expanded-history {
  margin-top: 1.5vh;
}

.expanded-desc strong,
.expanded-remarks strong,
.expanded-history strong {
  display: block;
  font-size: 0.85vw;
  color: var(--gray-700);
  margin-bottom: 0.5vh;
}

.expanded-desc p,
.expanded-remarks p {
  font-size: 0.85vw;
  color: var(--gray-600);
  line-height: 1.6;
}

.expanded-remarks {
  background: rgba(59, 130, 246, 0.05);
  padding: 1vh 1vw;
  border-left: 3px solid var(--accent-blue);
  border-radius: var(--radius-sm);
}

.expanded-history ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1vh;
}

.expanded-history li {
  display: flex;
  gap: 1vw;
  font-size: 0.8vw;
}

.history-dot {
  width: 8px;
  height: 8px;
  min-width: 8px;
  border-radius: 50%;
  margin-top: 0.5vh;
}
.history-dot.status-submitted { background: var(--gray-500); }
.history-dot.status-in-review { background: var(--accent-orange); }
.history-dot.status-in-progress { background: var(--accent-blue); }
.history-dot.status-resolved { background: var(--accent-green); }

.history-status-text {
  font-weight: 700;
  color: var(--navy-dark);
  text-transform: capitalize;
  margin-right: 0.8vw;
}

.history-date-text {
  color: var(--gray-400);
  font-size: 0.75vw;
}

.history-remark-text {
  color: var(--gray-600);
  margin-top: 0.3vh;
}

/* Empty States */
.empty-state {
  text-align: center;
  padding: 8vh 2vw;
  background: var(--gray-50);
  border: 2px dashed var(--gray-200);
  border-radius: var(--radius-lg);
}

.empty-icon { font-size: 4vw; opacity: 0.5; margin-bottom: 1vh; }
.empty-state h3 { font-size: 1.2vw; color: var(--navy-dark); }
.empty-state p { font-size: 0.9vw; color: var(--gray-500); margin-top: 0.5vh; }

/* Form Messages */
.form-message {
  padding: 1vh 1vw;
  border-radius: var(--radius-sm);
  font-size: 0.85vw;
  font-weight: 500;
  margin-top: 1vh;
}
.form-message.error { background: rgba(220, 38, 38, 0.08); color: var(--accent-red); border: 1px solid rgba(220, 38, 38, 0.2); }
.form-message.success { background: rgba(34, 197, 94, 0.08); color: var(--accent-green); border: 1px solid rgba(34, 197, 94, 0.2); }

/* =======================================================
   5. RESPONSIVE DESIGN (Mobile/Tablet)
   ======================================================= */
@media (max-width: 1024px) {
  .profile-layout { flex-direction: column; padding: 2vh 4vw; gap: 2vh; }
  .profile-sidebar { width: 100%; position: relative; top: 0; padding: 2vh 3vw; }
  .sidebar-user-card { flex-direction: row; text-align: left; gap: 2vw; padding-bottom: 1.5vh; margin-bottom: 1.5vh; }
  .sidebar-avatar { width: 8vw; height: 8vw; font-size: 3vw; margin-bottom: 0; }
  .sidebar-user-card h3 { font-size: 2.2vw; }
  .sidebar-user-card p { font-size: 1.5vw; }
  .sidebar-nav-menu { flex-direction: row; overflow-x: auto; padding-bottom: 1vh; gap: 1vw; }
  .sidebar-menu-item { white-space: nowrap; font-size: 1.5vw; padding: 1vh 2vw; }
  .sidebar-footer { display: none; } /* Mobile par logout header dropdown se karenge */
  
  .profile-content { padding: 2vh 4vw; }
  .tab-header h2 { font-size: 2.5vw; }
  .tab-header p { font-size: 1.4vw; }
  
  .profile-avatar-section { flex-direction: column; text-align: center; gap: 2vh; }
  .avatar-preview-container { width: 15vw; height: 15vw; }
  .avatar-initial { font-size: 6vw; }
  .avatar-info h4 { font-size: 2.5vw; }
  .avatar-info p, .avatar-info small { font-size: 1.5vw; }
  
  .profile-form { grid-template-columns: 1fr; gap: 1.5vh; }
  .profile-form .form-group label, .profile-form input, .profile-form select { font-size: 1.5vw; }
  .profile-form small { font-size: 1.2vw; }
  .save-btn { font-size: 1.6vw; }
  
  .security-form { max-width: 100%; }
  .security-form label, .security-form input { font-size: 1.5vw; }
  .update-btn { font-size: 1.6vw; }
  .card-title h3 { font-size: 2vw; }
  .card-title p { font-size: 1.4vw; }
  .card-icon { font-size: 2.5vw; }
  .danger-zone h3 { font-size: 2vw; }
  .danger-zone p { font-size: 1.4vw; max-width: 100%; }
  .delete-account-btn { font-size: 1.5vw; }
  
  .card-left h4 { font-size: 1.8vw; }
  .card-meta { font-size: 1.3vw; gap: 1.5vw; }
  .expanded-desc strong, .expanded-remarks strong, .expanded-history strong { font-size: 1.5vw; }
  .expanded-desc p, .expanded-remarks p { font-size: 1.4vw; }
  .expanded-history li { font-size: 1.3vw; }
  .history-date-text { font-size: 1.2vw; }
}

@media (max-width: 768px) {
  .sidebar-user-card h3 { font-size: 4vw; }
  .sidebar-user-card p { font-size: 3vw; }
  .sidebar-menu-item { font-size: 3vw; padding: 1.2vh 3vw; }
  
  .tab-header h2 { font-size: 5vw; }
  .tab-header p { font-size: 3vw; }
  
  .avatar-preview-container { width: 25vw; height: 25vw; }
  .avatar-initial { font-size: 10vw; }
  .avatar-info h4 { font-size: 4.5vw; }
  .avatar-info p, .avatar-info small { font-size: 3vw; }
  
  .profile-form .form-group label, .profile-form input, .profile-form select { font-size: 3vw; }
  .save-btn { font-size: 3.5vw; padding: 1.5vh; }
  
  .security-form label, .security-form input { font-size: 3vw; }
  .update-btn { font-size: 3.5vw; }
  .card-title h3 { font-size: 4vw; }
  .card-title p { font-size: 2.8vw; }
  .card-icon { font-size: 5vw; }
  .danger-zone h3 { font-size: 4vw; }
  .danger-zone p { font-size: 2.8vw; }
  .delete-account-btn { font-size: 3vw; padding: 1.5vh 3vw; }
  
  .card-left h4 { font-size: 3.5vw; }
  .card-meta { font-size: 2.6vw; gap: 2vw; }
  .dept-tag, .conf-tag { padding: 0.4vh 2vw; }
  .expanded-desc strong, .expanded-remarks strong, .expanded-history strong { font-size: 3vw; }
  .expanded-desc p, .expanded-remarks p { font-size: 2.8vw; }
  .expanded-history li { font-size: 2.6vw; }
  .history-date-text { font-size: 2.4vw; }
  
  .empty-icon { font-size: 10vw; }
  .empty-state h3 { font-size: 4.5vw; }
  .empty-state p { font-size: 3vw; }
}
