  font-size: 0.8vw;
  font-weight: 600;
  color: var(--gray-600);
  white-space: nowrap;
}

.pills-container {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5vw;
}

.filter-pill {
  padding: 0.6vh 1vw;
