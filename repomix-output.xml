.pin-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 30, 54, 0.7);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
  padding: 2vh 2vw;
}

.pin-modal {
  background: var(--white);
  border-radius: var(--radius-xl);
  padding: 3vh 2.5vw;
  width: 30vw;
  max-width: 420px;
  position: relative;
  animation: slideUp 0.3s ease;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
}

.modal-close {
  position: absolute;
  top: 1.5vh;
  right: 1vw;
  width: 2.5vw;
  height: 2.5vw;
  min-width: 32px;
  min-height: 32px;
  border-radius: 50%;
  background: var(--gray-100);
  color: var(--gray-600);
  font-size: 1vw;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.modal-close:hover {
