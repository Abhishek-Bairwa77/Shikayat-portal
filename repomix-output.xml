/* =========================================
   SCROLL FEED DARK THEME CSS (Reels Style)
   Card = 9:16, image full-bleed BEHIND title/description
   ========================================= */
.scroll-page-container {
  display: flex;
  height: 100vh;
  width: 100vw;
  background-color: #0b1120;
  color: #f8fafc;
  font-family: 'Inter', sans-serif;
  overflow: hidden;
}

/* ================= LEFT SIDEBAR (unchanged) ================= */
.sf-sidebar {
  width: 280px;
  min-width: 280px;
  background-color: #0f172a;
  border-right: 1px solid #1e293b;
  display: flex;
  flex-direction: column;
  padding: 24px 20px;
  z-index: 10;
  overflow-x: hidden;
  overflow-y: auto;            /* zoom/chhoti screen par cut hone ki jagah scroll */
  scrollbar-width: none;
}
.sf-sidebar::-webkit-scrollbar { display: none; }

.sf-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  margin-bottom: 40px;
}

.sf-logo-icon {
    width: 40px;          
  height: 40px;
  display: flex;        
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.sf-logo-text {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.sf-badge {
  font-size: 10px;
  background: #1e293b;
  color: #94a3b8;
  padding: 2px 6px;
  border-radius: 4px;
  letter-spacing: 0.5px;
}

.sf-logo-sub {
  font-size: 12px;
  color: #64748b;
  margin-top: 2px;
}

.sf-nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.sf-nav-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 16px;
  background: transparent;
  color: #94a3b8;
  border: none;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
}

.sf-nav-item:hover {
  background: rgba(255, 255, 255, 0.05);
  color: #f8fafc;
}

.sf-nav-item.active {
  background: #1e293b;
  color: #f8fafc;
  border-left: 3px solid #06b6d4;
}

.sf-active-dot {
  margin-left: auto;
  width: 8px;
  height: 8px;
  background: #06b6d4;
  border-radius: 50%;
  box-shadow: 0 0 10px #06b6d4;
}

.sf-count {
  margin-left: auto;
  background: #1e293b;
  color: #94a3b8;
  font-size: 12px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 99px;
}

.sf-count-red {
  background: #ef4444;
  color: white;
}

.sf-lodge-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 14px;
  margin: 20px 0;
  background: transparent;
  color: #06b6d4;
  border: 1.5px solid #06b6d4;
  border-radius: 99px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.sf-lodge-btn:hover {
  background: rgba(6, 182, 212, 0.1);
}

.sf-user-footer {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 20px;
  border-top: 1px solid #1e293b;
  cursor: pointer;
}

.sf-user-avatar {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #1e293b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 18px;
  color: #06b6d4;
}

.sf-user-avatar img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.sf-online-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 12px;
  height: 12px;
  background: #22c55e;
  border-radius: 50%;
  border: 2px solid #0f172a;
}

.sf-user-info h4 {
  font-size: 15px;
  margin: 0 0 2px 0;
  color: #f8fafc;
}

.sf-user-info p {
  font-size: 12px;
  color: #64748b;
  margin: 0;
}

/* ================= CENTER FEED ================= */
.sf-main-content {
  flex: 1;
  min-width: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  position: relative;
}

.sf-header {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 14px 0 10px;
  flex-shrink: 0;
  z-index: 20;
}

.sf-live-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: #1e293b;
  border-radius: 99px;
  font-size: 14px;
  font-weight: 600;
  color: #e2e8f0;
}

.sf-live-dot {
  width: 8px;
  height: 8px;
  background: #06b6d4;
  border-radius: 50%;
  animation: sf-pulse 2s infinite;
}

@keyframes sf-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}

/* Scroll container: ek swipe = ek card */
.sf-reels-container {
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow-y: scroll;
  scroll-snap-type: y mandatory;
  scroll-behavior: smooth;
}

.sf-reels-container::-webkit-scrollbar { display: none; }
.sf-reels-container { -ms-overflow-style: none; scrollbar-width: none; }

/* IMPORTANT: wrapper height == container height (ScrollFeed.jsx ka
   handleScroll isi par activeIndex nikalta hai). Padding border-box me hai. */
.sf-reel-wrapper {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  scroll-snap-align: center;
  scroll-snap-stop: always;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8px 20px 20px;
}

/* ================= REEL CARD ================= */
.sf-card {
  position: relative;
  box-sizing: border-box;
  height: 100%;
  max-height: 900px;
  aspect-ratio: 9 / 16;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;   /* text neeche, Reels ki tarah */
  gap: 8px;
  padding: 20px 20px 24px;
  background: #0f172a;
  border: 1px solid #1e293b;
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.5);
}

/* Dark gradient: neeche (text ke liye) aur upar (tags ke liye) */
.sf-card::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(to top,
      rgba(5, 10, 20, 0.96) 0%,
      rgba(5, 10, 20, 0.80) 32%,
      rgba(5, 10, 20, 0) 62%),
    linear-gradient(to bottom,
      rgba(5, 10, 20, 0.65) 0%,
      rgba(5, 10, 20, 0) 22%);
}

/* IMAGE: poore card me, sabse peeche */
.sf-card-image-wrapper {
  position: absolute;
  inset: 0;
  z-index: 0;
  margin: 0;
  border-radius: 0;
  overflow: hidden;
}

.sf-card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Agar image nahi hai: gradient placeholder, ye bhi peeche */
.sf-default-image {
  position: absolute;
  inset: 0;
  z-index: 0;
  margin: 0;
  border: none;
  border-radius: 0;
  background: linear-gradient(160deg, #1e293b 0%, #0f172a 55%, #0b1120 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 28%;
  color: #475569;
}

.sf-default-image svg {
  margin-bottom: 8px;
  opacity: 0.45;
}

.sf-default-image span {
  font-size: 13px;
  font-weight: 500;
  opacity: 0.7;
}

/* TAGS: card ke upar */
.sf-card-tags {
  position: absolute;
  top: 16px;
  left: 16px;
  right: 16px;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.sf-tag-category,
.sf-tag-status {
  font-size: 12px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 99px;
  letter-spacing: 0.4px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.sf-tag-category {
  background: rgba(6, 182, 212, 0.25);
  color: #67e8f9;
  border: 1px solid rgba(6, 182, 212, 0.45);
}

.sf-tag-status {
  background: rgba(245, 158, 11, 0.25);
  color: #fcd34d;
  border: 1px solid rgba(245, 158, 11, 0.45);
}

/* TEXT: image ke upar. order se meta -> title -> desc */
.sf-card-meta,
.sf-card-title,
.sf-card-desc {
  position: relative;
  z-index: 2;
  margin: 0;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
}

.sf-card-meta {
  order: 1;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  color: #cbd5e1;
}

.sf-card-title {
  order: 2;
  font-size: clamp(19px, 1.8vw, 24px);
  font-weight: 800;
  line-height: 1.25;
  color: #ffffff;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sf-card-desc {
  order: 3;
  font-size: 14.5px;
  line-height: 1.5;
  color: #e2e8f0;
  display: -webkit-box;
  -webkit-line-clamp: 4;       /* poora text detail page me dikhega */
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sf-read-more {
  position: relative;
  z-index: 2;
  order: 4;
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
